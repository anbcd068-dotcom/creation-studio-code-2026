<Window x:Class="CreationStudio2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creation Studio 2026" Icon="Assets/CreationStudio.ico" Width="1280" Height="800" Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="B" Background="#2D2D30" Padding="10,6" Margin="0,0,1,0">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="#CCCCCC"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click"/>
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="Open _Folder..." Click="OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run / Debug" InputGestureText="F5" Click="Run_Click"/>
                <MenuItem Header="_Stop" InputGestureText="Shift+F5" Click="Stop_Click"/>
                <MenuItem Header="_Clear Output" Click="ClearOutput_Click"/>
            </MenuItem>
            <MenuItem Header="_Languages">
                <MenuItem Header="_Re-scan installed languages" Click="Rescan_Click"/>
                <MenuItem Header="Show _detected languages" Click="ShowDetected_Click"/>
                <MenuItem Header="Open _custom languages file" Click="OpenCustom_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Click="New_Click" Padding="8,2"/>
            <Button Content="Open" Click="Open_Click" Padding="8,2"/>
            <Button Content="Save" Click="Save_Click" Padding="8,2"/>
            <Separator/>
            <Button x:Name="RunBtn" Content="▶ Run" Click="Run_Click" Padding="8,2" Foreground="DarkGreen"/>
            <Button x:Name="StopBtn" Content="■ Stop" Click="Stop_Click" Padding="8,2" Foreground="DarkRed" IsEnabled="False"/>
            <Separator/>
            <TextBlock Text="Language:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="LangBox" Width="210" DisplayMemberPath="Display" SelectionChanged="Lang_Changed"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="LangStatus"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Explorer" Grid.Column="0" Background="#252526" Foreground="#CCCCCC"
                      BorderThickness="0" MouseDoubleClick="Explorer_DoubleClick"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333337"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="Tabs" Grid.Row="0" Background="#1E1E1E" BorderThickness="0"
                            SelectionChanged="Tabs_SelectionChanged"/>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#333337"/>

                <Grid Grid.Row="2" Background="#1E1E1E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="INTEGRATED TERMINAL · OUTPUT" Foreground="#9D9D9D" Margin="8,4" FontSize="11"/>
                    <TextBox x:Name="Output" Grid.Row="1" IsReadOnly="True" Background="#1E1E1E" Foreground="#D4D4D4"
                             FontFamily="Consolas" FontSize="13" BorderThickness="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="8,0"/>
                    <DockPanel Grid.Row="2" Background="#252526">
                        <TextBlock Text="terminal ›" Foreground="#9D9D9D" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="Input" Background="#252526" Foreground="White" BorderThickness="0"
                                 FontFamily="Consolas" Padding="2,4" KeyDown="Input_KeyDown" CaretBrush="White" ToolTip="Type a command and press Enter. While a program is running, input is sent to that program."/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
